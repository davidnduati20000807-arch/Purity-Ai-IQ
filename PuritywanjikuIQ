import android.speech.tts.UtteranceProgressListener
import java.io.File
import java.net.HttpURLConnection
import java.net.URL
import java.util.Locale

class PurityService : Service(), TextToSpeech.OnInitListener {
    companion object {
        private const val CH_ID = "purity"
        private const val NOTIF_ID = 1
        private const val ACTION_STOP = "com.purity.assistant.STOP"
        private const val ACTION_TALK = "com.purity.assistant.TALK_FROM_NOTIF"
    }

    private lateinit var tts: TextToSpeech
    private var sr: SpeechRecognizer? = null
    private val h = Handler(Looper.getMainLooper())
    private var wl: PowerManager.WakeLock? = null
    @Volatile private var speaking = false
    @Volatile private var ttsReady = false

    override fun onBind(i: Intent?): IBinder? = null

    override fun onStartCommand(i: Intent?, f: Int, id: Int): Int {
        when (i?.action) {
            ACTION_STOP -> { stopSelf(); return START_NOT_STICKY }
            ACTION_TALK, "TALK" -> { PurityState.awake = true; h.postDelayed({ speak("Yes?") },
