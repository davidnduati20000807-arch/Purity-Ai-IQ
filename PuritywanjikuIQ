package com.purity.assistant

import android.Manifest
import android.app.Activity
import android.content.Intent
import android.content.pm.PackageManager
import android.content.pm.ShortcutInfo
import android.content.pm.ShortcutManager
import android.graphics.drawable.Icon
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.speech.tts.TextToSpeech
import android.text.InputType
import android.widget.*

class MainActivity : Activity() {

    private fun hasPerm(p: String) = checkSelfPermission(p) == PackageManager.PERMISSION_GRANTED

    override fun onCreate(b: Bundle?) {
        super.onCreate(b)
        val p = getSharedPreferences("purity", 0)

        val scroll = ScrollView(this)
        val l = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(48, 96, 48, 96)
        }
        fun btn(t: String, a: () -> Unit) = Button(this).apply {
            text = t
            setOnClickListener { a() }
        }
        fun label(t: String) = TextView(this).apply {
            text = t
            textSize = 15f
            setPadding(0, 24, 0, 6)
        }

        l.addView(TextView(this).apply {
            text = "Purity"
            textSize = 34f
        })
        l.addView(TextView(this).apply {
            text = "Voice assistant that can actually control your phone."
            setPadding(0, 0, 0, 32)
        })

        l.addView(label("Settings"))
        val fields = listOf(
            "Claude API key (required)" to "key",
            "ElevenLabs key (optional)" to "evkey",
            "ElevenLabs voice ID (optional)" to "voice",
            "Gmail address (optional)" to "mail",
            "Gmail app password (optional)" to "mailpw"
        )
        val edits = fields.map { (hn, k) ->
            EditText(this).apply {
                hint = hn
                setText(p.getString(k, ""))
                if (k == "key" || k == "evkey" || k == "mailpw")
                    inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
            }.also { l.addView(it) }
        }
        l.addView(btn("Save settings") {
            val e = p.edit()
            fields.forEachIndexed { i, f -> e.putString(f.second, edits[i].text.toString().trim()) }
            e.apply()
            toast("Saved")
        })

        l.addView(label("Permissions (do these once, in order)"))
        l.addView(btn("1. Grant runtime permissions") {
            val perms = mutableListOf(
                Manifest.permission.RECORD_AUDIO,
                Manifest.permission.CALL_PHONE,
                Manifest.permission.SEND_SMS,
                Manifest.permission.READ_CONTACTS,
                Manifest.permission.READ_CALENDAR,
                Manifest.permission.WRITE_CALENDAR,
                Manifest.permission.READ_SMS,
                Manifest.permission.ANSWER_PHONE_CALLS
            )
            if (Build.VERSION.SDK_INT >= 33) perms.add(Manifest.permission.POST_NOTIFICATIONS)
            requestPermissions(perms.toTypedArray(), 1)
        })
        l.addView(btn("2. Allow display over other apps") {
            startActivity(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, Uri.parse("package:$packageName")))
        })
        l.addView(btn("3. Enable screen control (Accessibility)") {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        })
        l.addView(btn("4. Enable notification access") {
            startActivity(Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS))
        })
        l.addView(btn("5. Allow changing brightness") {
            startActivity(Intent(Settings.ACTION_MANAGE_WRITE_SETTINGS, Uri.parse("package:$packageName")))
        })
        l.addView(btn("6. Ignore battery optimization (recommended)") {
            try {
                startActivity(Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, Uri.parse("package:$packageName")))
            } catch (e: Exception) { toast("Not available on this ROM") }
        })
        l.addView(btn("7. Shizuku permission (optional)") {
            try {
                if (rikka.shizuku.Shizuku.isPreV11() || rikka.shizuku.Shizuku.getVersion() < 11) {
                    toast("Please update Shizuku"); return@btn
                }
                if (rikka.shizuku.Shizuku.checkSelfPermission() == PackageManager.PERMISSION_GRANTED)
                    toast("Already granted")
                else rikka.shizuku.Shizuku.requestPermission(2)
            } catch (e: Throwable) {
                toast("Install and start Shizuku first")
            }
        })

        l.addView(label("Voice"))
        l.addView(btn("Install/choose a system TTS voice") {
            try { startActivity(Intent(TextToSpeech.Engine.ACTION_INSTALL_TTS_DATA)) } catch (e: Exception) {}
            toast("Settings > System > Languages > Text-to-speech")
        })

        l.addView(label("Quick access"))
        l.addView(btn("Add 'Talk to Purity' to home screen") { installShortcut() })

        l.addView(label("Run"))
        l.addView(btn("Talk to Purity now") {
            startForegroundService(Intent(this, PurityService::class.java).setAction("TALK"))
        })
        l.addView(btn("Start Purity (always listening)") {
            if (!hasPerm(Manifest.permission.RECORD_AUDIO)) {
                toast("Grant mic permission first"); return@btn
            }
            startForegroundService(Intent(this, PurityService::class.java))
        })
        l.addView(btn("Stop Purity") { stopService(Intent(this, PurityService::class.java)) })

        scroll.addView(l)
        setContentView(scroll)

        if (intent?.getBooleanExtra("talk", false) == true) {
            startForegroundService(Intent(this, PurityService::class.java).setAction("TALK"))
            finish()
        } else if (intent?.getBooleanExtra("auto", false) == true &&
            hasPerm(Manifest.permission.RECORD_AUDIO)) {
            startForegroundService(Intent(this, PurityService::class.java))
            finish()
        }
    }

    private fun toast(t: String) = Toast.makeText(this, t, Toast.LENGTH_SHORT).show()

    private fun installShortcut() {
        if (Build.VERSION.SDK_INT >= 26) {
            val sm = getSystemService(ShortcutManager::class.java)
            val target = Intent(this, MainActivity::class.java)
                .setAction(Intent.ACTION_VIEW)
                .putExtra("talk", true)
            val sc = ShortcutInfo.Builder(this, "talk_to_purity")
                .setShortLabel("Talk to Purity")
                .setLongLabel("Talk to Purity")
                .setIcon(Icon.createWithResource(this, R.drawable.ic_purity))
                .setIntent(target)
                .build()
            sm.requestPinShortcut(sc, null)
            toast("Shortcut requested")
        } else {
            @Suppress("DEPRECATION")
            val i = Intent("com.android.launcher.action.INSTALL_SHORTCUT")
                .putExtra(Intent.EXTRA_SHORTCUT_INTENT,
                    Intent(this, MainActivity::class.java).putExtra("talk", true))
                .putExtra(Intent.EXTRA_SHORTCUT_NAME, "Talk to Purity")
                .putExtra(Intent.EXTRA_SHORTCUT_ICON_RESOURCE,
                    Intent.ShortcutIconResource.fromContext(this, R.drawable.ic_purity))
            sendBroadcast(i)
            toast("Shortcut installed")
        }
    }
}
PURITY_EOF

